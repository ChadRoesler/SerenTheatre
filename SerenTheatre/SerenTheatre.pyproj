<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <!-- Unchanged on purpose: SerenTheatre.slnx references this GUID. -->
    <ProjectGuid>01367d4e-9473-4ffe-8ce1-a5a170d81010</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <!-- Run python -m seren_theatre when you hit F5. Was SerenTheatre.py, the
         2-byte VS scaffold stub, which started nothing. -->
    <StartupFile>seren_theatre\__main__.py</StartupFile>
    <SearchPath>.</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>SerenTheatre</Name>
    <RootNamespace>seren_theatre</RootNamespace>
    <InterpreterId>Global|PythonCore|3.11</InterpreterId>
    <IsWindowsApplication>False</IsWindowsApplication>
    <Description>Watch a model being made. Read-only viewer over training logs and artifacts.</Description>
    <TestFramework>Pytest</TestFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="seren_theatre\archive\blobs.py" />
    <Compile Include="seren_theatre\archive\bundle.py" />
    <Compile Include="seren_theatre\archive\compare.py" />
    <Compile Include="seren_theatre\archive\harvest.py" />
    <Compile Include="seren_theatre\archive\store.py" />
    <Compile Include="seren_theatre\archive\__init__.py" />
    <Compile Include="seren_theatre\evalreport.py" />
    <Compile Include="seren_theatre\__init__.py" />
    <Compile Include="seren_theatre\__main__.py" />
    <Compile Include="seren_theatre\_diag.py" />
    <Compile Include="seren_theatre\app.py" />
    <Compile Include="seren_theatre\backstage.py" />
    <Compile Include="seren_theatre\config.py" />
    <Compile Include="seren_theatre\evalrecord.py" />
    <Compile Include="seren_theatre\manifest.py" />
    <Compile Include="seren_theatre\sources.py" />
    <Compile Include="seren_theatre\stageguard.py" />
    <Compile Include="seren_theatre\stagehand.py" />
    <Compile Include="tests\conftest.py" />
    <Compile Include="tests\test_archive.py" />
    <Compile Include="tests\test_archive_durability.py" />
    <Compile Include="tests\test_artifact_names.py" />
    <Compile Include="tests\test_bundle_contract.py" />
    <Compile Include="tests\test_cli_contract.py" />
    <Compile Include="tests\test_compare.py" />
    <Compile Include="tests\test_eval_run.py" />
    <Compile Include="tests\test_nothing_is_built_and_unwired.py" />
    <Compile Include="tests\test_pipeline_command.py" />
    <Compile Include="tests\test_presence_is_three_valued.py" />
    <Compile Include="tests\test_readings.py" />
    <Compile Include="tests\test_recipe_in_the_archive.py" />
    <Compile Include="tests\test_remote_launch.py" />
    <Compile Include="tests\test_repertoire.py" />
    <Compile Include="tests\test_results.py" />
    <Compile Include="tests\test_results_contract.py" />
    <Compile Include="tests\test_results_end_to_end.py" />
    <Compile Include="tests\test_rung_discovery.py" />
    <Compile Include="tests\test_sample_config.py" />
    <Compile Include="tests\test_stage_contract.py" />
    <Compile Include="tests\test_sweep.py" />
    <Compile Include="tests\test_the_build_says_where_it_is.py" />
    <Compile Include="tests\test_the_stage_holds_one_run.py" />
    <Compile Include="tests\_writerfinder.py" />
    <Compile Include="tests\test_app.py" />
    <Compile Include="tests\test_backstage.py" />
    <Compile Include="tests\test_config.py" />
    <Compile Include="tests\test_eval_contract.py" />
    <Compile Include="tests\test_manifest.py" />
    <Compile Include="tests\test_manifest_contract.py" />
    <Compile Include="tests\test_stagehand.py" />
    <Compile Include="tests\test_updates_contract.py" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="seren_theatre\" />
    <Folder Include="seren_theatre\archive\" />
    <Folder Include="seren_theatre\viewer\" />
    <Folder Include="seren_theatre\viewer\ui\" />
    <Folder Include="tests\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="pyproject.toml" />
    <Content Include="README.md" />
    <Content Include="seren-theatre.yaml.sample" />
    <!-- The viewer pack. Content, not Compile - and declared as package-data
         in pyproject.toml, without which these are simply absent from the
         wheel and /viewer 500s on an installed copy. -->
    <Content Include="seren_theatre\viewer\ui\body.html" />
    <Content Include="seren_theatre\viewer\ui\tabs.html" />
    <Content Include="seren_theatre\viewer\ui\header_aside.html" />
    <Content Include="seren_theatre\viewer\ui\styles.css" />
    <Content Include="seren_theatre\viewer\ui\scripts.js" />
  </ItemGroup>
  <ItemGroup>
    <InterpreterReference Include="Global|PythonCore|3.11" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>